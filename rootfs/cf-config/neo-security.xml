<?xml version="1.0" encoding="UTF-8"?>
<!--
  neo-security.xml — ColdFusion Admin security settings
  Location: /opt/coldfusion2025/cfusion/lib/neo-security.xml

  Admin credentials for training:
    Username: admin
    Password: training

  The password hash below is SHA-256("training") — replace with the real hash
  generated by the CF installer if using different credentials.
  Hash: SHA-256 of "training" = 12FCE8...  (placeholder; real install generates this)

  NOTE: For a real build, run the CF installer once, set the password to "training"
  in the installer wizard or via -f silent-install.properties, then copy the
  generated neo-security.xml into this repo.
-->
<wddxPacket version="1.0">
  <header/>
  <data>
    <struct>
      <!-- Admin authentication mode: 0=username+password -->
      <var name="CFIDE_ADMINISTRATOR_AUTHENTICATIONMODE"><number>0</number></var>

      <!-- Admin password (SHA hashed by CF itself during first boot if empty here) -->
      <var name="CFIDE_ADMINISTRATOR_PASSWORD"><string>training</string></var>
      <var name="CFIDE_ADMINISTRATOR_SECURITYPASWORDCHANGEREQUIRED"><boolean value="false"/></var>

      <!-- Sandbox security — disabled for training simplicity -->
      <var name="CFIDE_ADMINISTRATOR_SANDBOXENABLED"><boolean value="false"/></var>

      <!-- RDS access — disabled -->
      <var name="CFIDE_ADMINISTRATOR_RDSPASSWORD"><string></string></var>
      <var name="CFIDE_ADMINISTRATOR_RDSENABLED"><boolean value="false"/></var>

      <!-- Allow concurrent admin sessions -->
      <var name="CFIDE_ADMINISTRATOR_ALLOWCONCURRENTADMINSESSIONS"><boolean value="true"/></var>

      <!-- IP-based admin restriction — none (training environment, not production) -->
      <var name="CFIDE_ADMINISTRATOR_IPLIST"><string></string></var>
    </struct>
  </data>
</wddxPacket>
